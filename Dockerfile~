FROM rocker/tidyverse:4

## system dependencies for building some R packages
RUN apt-get update && apt-get install -y \
	libglpk-dev \
	libxml2-dev

COPY . /veupathUtils
WORKDIR /veupathUtils

## Make a symlink in the rstudio homedir
RUN ln -s /veupathUtils /home/rstudio/veupathUtils

### CRAN
RUN R -e "install.packages('remotes')"
# RUN R -e "install.packages('BiocManager')"

### local (installs github and BioConductor dependencies automatically)
RUN R -e "remotes::install_local('/veupathUtils', dependencies=TRUE)"
